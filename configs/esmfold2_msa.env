# Full ESMFold2 with cached remote, unpaired MSAs.
# Source this file after configs/env.example or export ASTEVOLVE_RUNTIME_ROOT first.
export ASTEVOLVE_RUNTIME_ROOT="${ASTEVOLVE_RUNTIME_ROOT:-/srv/dastevolve-runtime}"
export ASTEVOLVE_ESMFOLD2_MODE="local"
export ASTEVOLVE_ESMFOLD2_CONDA_ENV="esmfold2"
export ASTEVOLVE_ESMFOLD2_MODEL="${ASTEVOLVE_RUNTIME_ROOT}/models/biohub/ESMFold2"
export ASTEVOLVE_ESMFOLD2_ESMC_MODEL="${ASTEVOLVE_RUNTIME_ROOT}/models/biohub/ESMC-6B"
export ESMCFOLD_CCD_PATH="${ASTEVOLVE_RUNTIME_ROOT}/models/biohub/ESMFold2/ccd.pkl"
export ASTEVOLVE_ESMFOLD2_ALLOW_DOWNLOAD="0"

# Enabling this sends protein sequences to the configured third-party service.
export ASTEVOLVE_ESMFOLD2_MSA_MODE="remote"
export ASTEVOLVE_ESMFOLD2_MSA_URL="https://api.colabfold.com"
export ASTEVOLVE_ESMFOLD2_MSA_CACHE="${ASTEVOLVE_RUNTIME_ROOT}/datasets/msa_cache"
export ASTEVOLVE_ESMFOLD2_MSA_USE_ENV="1"
export ASTEVOLVE_ESMFOLD2_MSA_USE_FILTER="1"
export ASTEVOLVE_ESMFOLD2_MSA_TIMEOUT="1800"
export ASTEVOLVE_ESMFOLD2_MSA_REQUEST_TIMEOUT="30"
export ASTEVOLVE_ESMFOLD2_MSA_NETWORK_RETRIES="5"
export ASTEVOLVE_ESMFOLD2_MSA_USER_AGENT="${ASTEVOLVE_ESMFOLD2_MSA_USER_AGENT:-DASTevolve/0.1 remote-msa}"

export HF_HUB_OFFLINE="1"
export TRANSFORMERS_OFFLINE="1"
