
_dastevolve_config_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -d "${_dastevolve_config_dir}/astevolve" && -f "${_dastevolve_config_dir}/pyproject.toml" ]]; then
  _dastevolve_detected_root="${_dastevolve_config_dir}"
else
  _dastevolve_detected_root="$(cd "${_dastevolve_config_dir}/.." && pwd -P)"
fi
export ASTEVOLVE_PROJECT_ROOT="${ASTEVOLVE_PROJECT_ROOT:-${_dastevolve_detected_root}}"
export ASTEVOLVE_RUNTIME_ROOT="${ASTEVOLVE_RUNTIME_ROOT:-${ASTEVOLVE_PROJECT_ROOT}/../DASTevolve_runtime}"

export ASTEVOLVE_DATA_ROOT="${ASTEVOLVE_DATA_ROOT:-${ASTEVOLVE_RUNTIME_ROOT}/datasets}"
export ASTEVOLVE_MODEL_ROOT="${ASTEVOLVE_MODEL_ROOT:-${ASTEVOLVE_RUNTIME_ROOT}/models}"
export ASTEVOLVE_TOOL_ROOT="${ASTEVOLVE_TOOL_ROOT:-${ASTEVOLVE_RUNTIME_ROOT}/tools}"
export ASTEVOLVE_ARTIFACT_ROOT="${ASTEVOLVE_ARTIFACT_ROOT:-${ASTEVOLVE_RUNTIME_ROOT}/runs}"
export ASTEVOLVE_RUN_ROOT="${ASTEVOLVE_RUN_ROOT:-${ASTEVOLVE_ARTIFACT_ROOT}}"
export ASTEVOLVE_TMP_ROOT="${ASTEVOLVE_TMP_ROOT:-${ASTEVOLVE_RUNTIME_ROOT}/tmp}"

export ASTEVOLVE_LLM_API_BASE="${ASTEVOLVE_LLM_API_BASE:-}"
export ASTEVOLVE_LLM_API_KEY="${ASTEVOLVE_LLM_API_KEY:-}"
export ASTEVOLVE_LLM_MODEL="${ASTEVOLVE_LLM_MODEL:-}"

export ASTEVOLVE_PROGEN_MODEL_DIR="${ASTEVOLVE_PROGEN_MODEL_DIR:-${ASTEVOLVE_MODEL_ROOT}/progen2-small}"
export ASTEVOLVE_PROGEN_DEVICE="${ASTEVOLVE_PROGEN_DEVICE:-cuda}"

export ASTEVOLVE_MASKED_LM_MODEL_DIR="${ASTEVOLVE_MASKED_LM_MODEL_DIR:-${ASTEVOLVE_MODEL_ROOT}/esm2_t6_8M_UR50D}"

export ASTEVOLVE_BAGEL_ROOT="${ASTEVOLVE_BAGEL_ROOT:-${ASTEVOLVE_TOOL_ROOT}/bagel}"
export ASTEVOLVE_ESMFOLD_PYTHON="${ASTEVOLVE_ESMFOLD_PYTHON:-${ASTEVOLVE_BAGEL_ROOT}/.venv-local/bin/python}"
export ASTEVOLVE_ESMFOLD_MODEL="${ASTEVOLVE_ESMFOLD_MODEL:-${ASTEVOLVE_MODEL_ROOT}/esmfold_v1}"
export ASTEVOLVE_ESMFOLD_TMP="${ASTEVOLVE_ESMFOLD_TMP:-${ASTEVOLVE_TMP_ROOT}/esmfold}"

export ASTEVOLVE_ESMFOLD2_MODE="${ASTEVOLVE_ESMFOLD2_MODE:-local}"
export ASTEVOLVE_ESMFOLD2_CONDA_ENV="${ASTEVOLVE_ESMFOLD2_CONDA_ENV:-}"
export ASTEVOLVE_ESMFOLD2_MODEL="${ASTEVOLVE_ESMFOLD2_MODEL:-${ASTEVOLVE_MODEL_ROOT}/biohub/ESMFold2-Fast}"
export ASTEVOLVE_ESMFOLD2_ESMC_MODEL="${ASTEVOLVE_ESMFOLD2_ESMC_MODEL:-${ASTEVOLVE_MODEL_ROOT}/biohub/ESMC-6B}"
export ESMCFOLD_CCD_PATH="${ESMCFOLD_CCD_PATH:-${ASTEVOLVE_MODEL_ROOT}/biohub/ESMFold2/ccd.pkl}"
export ASTEVOLVE_ESMFOLD2_TMP="${ASTEVOLVE_ESMFOLD2_TMP:-${ASTEVOLVE_TMP_ROOT}/esmfold2}"
export ASTEVOLVE_ESMFOLD2_ALLOW_DOWNLOAD="${ASTEVOLVE_ESMFOLD2_ALLOW_DOWNLOAD:-0}"
# Full ESMFold2 only: off | file | remote. Remote sends sequences to a third party.
export ASTEVOLVE_ESMFOLD2_MSA_MODE="${ASTEVOLVE_ESMFOLD2_MSA_MODE:-off}"
export ASTEVOLVE_ESMFOLD2_MSA_PATHS="${ASTEVOLVE_ESMFOLD2_MSA_PATHS:-}"
export ASTEVOLVE_ESMFOLD2_MSA_URL="${ASTEVOLVE_ESMFOLD2_MSA_URL:-https://api.colabfold.com}"
export ASTEVOLVE_ESMFOLD2_MSA_CACHE="${ASTEVOLVE_ESMFOLD2_MSA_CACHE:-${ASTEVOLVE_DATA_ROOT}/msa_cache}"
export ASTEVOLVE_ESMFOLD2_MSA_MAX_SEQUENCES="${ASTEVOLVE_ESMFOLD2_MSA_MAX_SEQUENCES:-}"
export ASTEVOLVE_ESMFOLD2_MSA_USE_ENV="${ASTEVOLVE_ESMFOLD2_MSA_USE_ENV:-1}"
export ASTEVOLVE_ESMFOLD2_MSA_USE_FILTER="${ASTEVOLVE_ESMFOLD2_MSA_USE_FILTER:-1}"
export ASTEVOLVE_ESMFOLD2_MSA_TIMEOUT="${ASTEVOLVE_ESMFOLD2_MSA_TIMEOUT:-1800}"
export ASTEVOLVE_ESMFOLD2_MSA_REQUEST_TIMEOUT="${ASTEVOLVE_ESMFOLD2_MSA_REQUEST_TIMEOUT:-30}"
export ASTEVOLVE_ESMFOLD2_MSA_NETWORK_RETRIES="${ASTEVOLVE_ESMFOLD2_MSA_NETWORK_RETRIES:-5}"
export ASTEVOLVE_ESMFOLD2_MSA_USER_AGENT="${ASTEVOLVE_ESMFOLD2_MSA_USER_AGENT:-DASTevolve/0.1 remote-msa}"

export ASTEVOLVE_PROTENIX_ROOT="${ASTEVOLVE_PROTENIX_ROOT:-${ASTEVOLVE_MODEL_ROOT}/protenix}"
export ASTEVOLVE_PROTENIX_TMP="${ASTEVOLVE_PROTENIX_TMP:-${ASTEVOLVE_TMP_ROOT}/protenix}"
export ASTEVOLVE_PROTENIX_CONDA_ENV="${ASTEVOLVE_PROTENIX_CONDA_ENV:-}"
export ASTEVOLVE_PROTENIX_MODEL_NAME="${ASTEVOLVE_PROTENIX_MODEL_NAME:-protenix_mini_esm_v0.5.0}"
export ASTEVOLVE_PROTENIX_MSA_TEMPLATE_ROOT="${ASTEVOLVE_PROTENIX_MSA_TEMPLATE_ROOT:-}"
export ASTEVOLVE_PROTENIX_COMPLEX_USE_MSA="${ASTEVOLVE_PROTENIX_COMPLEX_USE_MSA:-}"
export ASTEVOLVE_PROTENIX_COMPLEX_CYCLE="${ASTEVOLVE_PROTENIX_COMPLEX_CYCLE:-}"
export ASTEVOLVE_PROTENIX_COMPLEX_STEP="${ASTEVOLVE_PROTENIX_COMPLEX_STEP:-}"
export ASTEVOLVE_PROTENIX_COMPLEX_SAMPLE="${ASTEVOLVE_PROTENIX_COMPLEX_SAMPLE:-}"
export ASTEVOLVE_PROTENIX_COMPLEX_USE_DEFAULT_PARAMS="${ASTEVOLVE_PROTENIX_COMPLEX_USE_DEFAULT_PARAMS:-}"
export ASTEVOLVE_PROTENIX_NUM_WORKERS="${ASTEVOLVE_PROTENIX_NUM_WORKERS:-1}"
export ASTEVOLVE_PROTENIX_NEED_ATOM_CONFIDENCE="${ASTEVOLVE_PROTENIX_NEED_ATOM_CONFIDENCE:-1}"
export ASTEVOLVE_PROTENIX_TIMEOUT="${ASTEVOLVE_PROTENIX_TIMEOUT:-600}"
export ASTEVOLVE_ENABLE_PROTENIX="${ASTEVOLVE_ENABLE_PROTENIX:-0}"

export ASTEVOLVE_AF3_ROOT="${ASTEVOLVE_AF3_ROOT:-${ASTEVOLVE_TOOL_ROOT}/alphafold3}"
export ASTEVOLVE_AF3_MODEL_DIR="${ASTEVOLVE_AF3_MODEL_DIR:-${ASTEVOLVE_MODEL_ROOT}/alphafold3}"
export ASTEVOLVE_AF3_DB_DIR="${ASTEVOLVE_AF3_DB_DIR:-}"
export ASTEVOLVE_AF3_TMP="${ASTEVOLVE_AF3_TMP:-${ASTEVOLVE_TMP_ROOT}/alphafold3}"
export ASTEVOLVE_AF3_CONDA_ENV="${ASTEVOLVE_AF3_CONDA_ENV:-alphafold3}"
export ASTEVOLVE_AF3_RUN_DATA_PIPELINE="${ASTEVOLVE_AF3_RUN_DATA_PIPELINE:-0}"
export ASTEVOLVE_AF3_NUM_RECYCLES="${ASTEVOLVE_AF3_NUM_RECYCLES:-10}"
export ASTEVOLVE_AF3_NUM_DIFFUSION_SAMPLES="${ASTEVOLVE_AF3_NUM_DIFFUSION_SAMPLES:-1}"
export ASTEVOLVE_AF3_FLASH_ATTENTION="${ASTEVOLVE_AF3_FLASH_ATTENTION:-triton}"
export ASTEVOLVE_AF3_GPU_DEVICE="${ASTEVOLVE_AF3_GPU_DEVICE:-0}"
export ASTEVOLVE_AF3_SEED="${ASTEVOLVE_AF3_SEED:-202}"
export ASTEVOLVE_AF3_TIMEOUT="${ASTEVOLVE_AF3_TIMEOUT:-7200}"

export ASTEVOLVE_PYROSETTA_PYTHON="${ASTEVOLVE_PYROSETTA_PYTHON:-}"
export ASTEVOLVE_PYROSETTA_INTERFACE="${ASTEVOLVE_PYROSETTA_INTERFACE:-}"
export ASTEVOLVE_ROSETTA_INTERFACE_ANALYZER="${ASTEVOLVE_ROSETTA_INTERFACE_ANALYZER:-}"
export ASTEVOLVE_GETCONTACTS_ROOT="${ASTEVOLVE_GETCONTACTS_ROOT:-${ASTEVOLVE_TOOL_ROOT}/getcontacts}"
export ASTEVOLVE_GETCONTACTS_BIN="${ASTEVOLVE_GETCONTACTS_BIN:-}"
export ASTEVOLVE_GET_STATIC_CONTACTS_BIN="${ASTEVOLVE_GET_STATIC_CONTACTS_BIN:-}"

export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
unset _dastevolve_config_dir _dastevolve_detected_root
